{
    "name": "vatly/vatly-fluent-php",
    "description": "Framework-agnostic fluent PHP SDK for Vatly, the European Merchant of Record for AI, software and digital products",
    "keywords": ["vatly", "billing", "subscriptions", "payments", "merchant-of-record", "vat", "ai"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sander van Hooft",
            "email": "sander@vanhooft.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "vatly/vatly-api-php": "^0.1.0-alpha.34"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Vatly\\Fluent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vatly\\Fluent\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "analyze": "@analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

{
    "name": "vatly/vatly-fluent-php",
    "description": "Framework-agnostic fluent PHP SDK for Vatly billing",
    "keywords": ["vatly", "billing", "subscriptions", "payments"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sander van Hooft",
            "email": "sander@vanhooft.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/vatly/vatly-api-php"
        }
    ],
    "require": {
        "php": "^8.1",
        "vatly/vatly-api-php": "dev-sync/openapi-2026-08 as 0.1.0-alpha.25"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Vatly\\Fluent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vatly\\Fluent\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "analyze": "@analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
